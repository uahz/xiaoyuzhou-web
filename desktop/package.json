{
  "name": "xiaoyuzhou-desktop",
  "productName": "小宇宙",
  "version": "1.0.0",
  "description": "小宇宙播客客户端 · 桌面版（Windows / macOS）",
  "main": "src/main.js",
  "author": "uahz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.uahz.xiaoyuzhou",
    "productName": "小宇宙",
    "copyright": "Copyright © 2026 uahz",
    "directories": {
      "output": "dist-out",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "xiaoyuzhou-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小宇宙"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "artifactName": "xiaoyuzhou-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "xiaoyuzhou-${version}",
      "icon": "build/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uahz/xiaoyuzhou-web.git"
  }
}